{
  "name": "forensics",
  "version": "3.0.0-dev",
  "private": true,
  "type": "module",
  "description": "Client-side file forensics: a privacy X-ray for every file, and the fix. Parsers run in a Web Worker; nothing is uploaded. Zero runtime dependencies.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --serve",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/build.mjs && playwright test",
    "samples": "node scripts/make-samples.mjs",
    "check": "npm run typecheck && npm test",
    "preview": "node scripts/serve.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "keywords": [
    "forensics",
    "metadata",
    "exif",
    "heic",
    "mp4",
    "docx",
    "pdf",
    "steganalysis",
    "error-level-analysis",
    "hex-viewer",
    "privacy",
    "client-side",
    "zero-dependencies"
  ],
  "author": "Shreyas Fegade",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
